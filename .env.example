# Optional: server-side calendar OAuth clients.
# Leave both halves of a provider empty to keep its sign-in entry disabled.
# Production deployments should set these with `wrangler secret put`, not commit real values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=

# Optional: the public origin used for the OAuth callback. Unset uses the request origin.
# CALENDAR_OAUTH_REDIRECT_BASE=https://notes.example.com

# Optional: YouTube Data API v3. Set the key as a secret in production (`wrangler secret put`).
# Without it the YouTube app shows its saved library and reports the missing key.
YOUTUBE_API_KEY=
# Optional: a proxy base for the Data API (https only).
# YOUTUBE_API_BASE=https://www.googleapis.com/youtube/v3
# Optional: the region mostPopular describes (two uppercase letters).
# YOUTUBE_REGION_CODE=US
# Optional: the deployment daily unit budget (defaults to 10000).
# YOUTUBE_DAILY_QUOTA=10000
