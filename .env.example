# Optional: server-side calendar OAuth clients.
# Leave both halves of a provider empty to keep its sign-in entry disabled.
# Production deployments should set these with `wrangler secret put`, not commit real values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=

# Optional: the public origin used for the OAuth callback. Unset uses the request origin.
# CALENDAR_OAUTH_REDIRECT_BASE=https://notes.example.com

# Optional: default password for navigation categories that use the server default.
# Set with `wrangler secret put NAV_DEFAULT_CATEGORY_PASSWORD` in production.
NAV_DEFAULT_CATEGORY_PASSWORD=
