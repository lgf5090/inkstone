{
  "name": "inkstone",
  "private": true,
  "version": "0.8.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "Inkstone is a self-hosted Markdown notebook that runs entirely on Cloudflare Workers.",
  "homepage": "https://github.com/shuaiplus/inkstone#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shuaiplus/inkstone.git"
  },
  "bugs": {
    "url": "https://github.com/shuaiplus/inkstone/issues"
  },
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:ai": "vite --mode ai",
    "dev:kv": "vite --mode kv",
    "dev:demo": "vite --mode demo",
    "build": "npm run build:types && vite build",
    "build:kv": "npm run build:types && vite build --mode kv",
    "build:demo": "npm run build:types && vite build --mode demo",
    "build:types": "node --max-old-space-size=3072 node_modules/typescript/bin/tsc -b tsconfig.client.json tsconfig.worker.json tsconfig.node.json",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && npx wrangler deploy --config dist/inkstone/wrangler.json",
    "deploy:kv": "npm run build:kv && npx wrangler deploy --config dist/inkstone/wrangler.json",
    "deploy:check": "npm run build && npx wrangler deploy --dry-run --config dist/inkstone/wrangler.json",
    "deploy:check:kv": "npm run build:kv && npx wrangler deploy --dry-run --config dist/inkstone/wrangler.json",
    "deploy:demo": "npm run build:demo && npx wrangler deploy --config wrangler.demo.toml",
    "typecheck": "tsc -b",
    "typecheck:force": "tsc -b --force",
    "typecheck:tests": "tsc -b tsconfig.tests.json",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:file": "vitest run --config vitest.config.ts",
    "test:changed": "vitest run --config vitest.config.ts --changed HEAD --passWithNoTests",
    "test:related": "vitest related --config vitest.config.ts --run --passWithNoTests",
    "test:watch": "vitest --config vitest.config.ts",
    "i18n:check": "node scripts/check-i18n.mjs",
    "comments:check": "node scripts/check-comments.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "cf-typegen": "wrangler types",
    "cf-typegen:kv": "wrangler types --config wrangler.kv.toml",
    "postinstall": "node scripts/patch-excalidraw.mjs"
  },
