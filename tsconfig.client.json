{
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": "./node_modules/.tmp/tsc/client",
    "tsBuildInfoFile": "./node_modules/.tmp/tsc/client.tsbuildinfo",

    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "types": ["vite/client"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "useDefineForClassFields": true,

    "paths": {
      "@/*": ["./src/client/*"],
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": ["src/client/**/*", "src/shared/**/*", "package.json"],
  // Scratch probes (*.tmp.*, gitignored) stay out of the compiler's file list so one session's
  // in-flight measurement cannot redden another's `tsc -b`. tests/no-scratch-test-files.test.ts
  // is the half that keeps an excluded probe from being forgotten.
  "exclude": ["**/*.tmp.*"]
}
