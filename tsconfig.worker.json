{
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": "./node_modules/.tmp/tsc/worker",
    "tsBuildInfoFile": "./node_modules/.tmp/tsc/worker.tsbuildinfo",

    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": ["@cloudflare/workers-types"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,

    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@dayflow/caldav": ["./src/worker/calendar/vendor/dayflow-caldav.d.ts"],
      "@dayflow/google-sync": ["./src/worker/calendar/vendor/dayflow-google-sync.d.ts"],
      "@dayflow/outlook-sync": ["./src/worker/calendar/vendor/dayflow-outlook-sync.d.ts"]
    }
  },
  "include": ["src/worker/**/*", "src/shared/**/*", "package.json"],
  // Same scratch-probe exclusion as tsconfig.client.json; see tests/no-scratch-test-files.test.ts.
  "exclude": ["**/*.tmp.*"]
}
